# Copy to .env locally. Do not commit real credentials.
# P06 receives Trend and Stock results from P08; it does not need operational DB credentials.
# Keep upstream database access and the combined Trend/Stock retrieval in the owning service.
# Optional image generation; the API key alone does not enable requests.
LLM_API_KEY=
# Optional text planning provider. The /runs endpoint only calls it when explicitly enabled.
VOGUE_TEXT_GENERATION_MODEL=gpt-6-luna
VOGUE_TEXT_GENERATION_TIMEOUT_SECONDS=60
VOGUE_TEXT_GENERATION_MAX_OUTPUT_TOKENS=3000
VOGUE_TEXT_GENERATION_ENABLED=true

# Set explicitly to enable real product/outfit image generation.
VOGUE_DRAFT_IMAGE_PROVIDER=
VOGUE_DRAFT_IMAGE_MODEL=gpt-image-2.5-sunburst
VOGUE_DRAFT_IMAGE_TIMEOUT_SECONDS=180
VOGUE_DRAFT_ARTIFACT_DIR=data/local/p06-artifacts
