# Copy to .env locally. Do not commit real credentials.
# Optional image generation; the API key alone does not enable requests.
LLM_API_KEY=
OPENAI_API_KEY=
VOGUE_IMAGE_GENERATION_ENABLED=false
# H&M/R2 stock photos may be forwarded to the outfit image provider by default.
VOGUE_R2_IMAGE_ALLOW_PROVIDER_UPLOAD=true
