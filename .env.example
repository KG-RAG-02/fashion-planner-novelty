# 로컬 설정 예시. .env로 복사해 쓰고 실제 비밀 값은 커밋하지 않는다.
# novelty는 orchestrator가 보낸 trend·inventory 결과만 읽으므로 업무 데이터베이스 접속 정보가 필요 없다.

# 실행 모드: local(루프백, 토큰 없음) | private(bearer 토큰) | service(bearer 토큰 + TLS)
NOVELTY_HTTP_MODE=local
NOVELTY_HOST=127.0.0.1
NOVELTY_PORT=8767
# private·service 모드에서 서비스들이 함께 쓰는 bearer 토큰
FASHION_PLANNER_SERVICE_TOKEN=
# service 모드의 TLS 인증서와 키 경로
NOVELTY_TLS_CERT_FILE=
NOVELTY_TLS_KEY_FILE=

# OpenAI API 키. 비우면 모델을 부르지 않고 규칙 기반 Draft만 돌려준다.
LLM_API_KEY=

# 텍스트 LLM 기획(키가 있을 때만 호출)
NOVELTY_TEXT_GENERATION_ENABLED=true
NOVELTY_TEXT_GENERATION_MODEL=gpt-6-luna
NOVELTY_TEXT_GENERATION_TIMEOUT_SECONDS=60
NOVELTY_TEXT_GENERATION_MAX_OUTPUT_TOKENS=3000

# 이미지 생성: openai로 두면 상품·착장 이미지를 만든다(유료). synthetic이면 외부 호출 없이
# SYNTHETIC 자리표시 PNG를 만든다(e2e·데모용). 비우면 두 이미지가 skipped.
NOVELTY_DRAFT_IMAGE_PROVIDER=
NOVELTY_DRAFT_IMAGE_MODEL=gpt-image-2.5-sunburst
NOVELTY_DRAFT_IMAGE_TIMEOUT_SECONDS=180
NOVELTY_DRAFT_ARTIFACT_DIR=data/local/novelty-artifacts
