# Copy to .env locally. Do not commit real credentials.
# Optional image generation; the API key alone does not enable requests.
LLM_API_KEY=
OPENAI_API_KEY=
VOGUE_IMAGE_GENERATION_ENABLED=false
# Structured text planning uses OpenAI Responses API only when explicitly enabled.
VOGUE_TEXT_GENERATION_ENABLED=false
VOGUE_TEXT_GENERATION_MODEL=gpt-6-astra
VOGUE_TEXT_GENERATION_TIMEOUT_SECONDS=60
VOGUE_TEXT_GENERATION_MAX_OUTPUT_TOKENS=3000
# Cloudflare R2 read-only runtime access. Keep credentials in a secret store.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_DB_KEY=stock-synthetic-workbench-20261111-7ec096205749.duckdb
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGE_PREFIX=
# Uses only the versioned synthetic planning workbench fixture; disabled by default.
VOGUE_SYNTHETIC_PLANNING_RAG_ENABLED=false
# When enabled, production source defaults to the merged R2 DuckDB. Set to `local` only for explicit fixture development.
VOGUE_SYNTHETIC_PLANNING_RAG_SOURCE=r2
# Optional override; otherwise the R2_DB_KEY above selects the planning DB object.
VOGUE_SYNTHETIC_PLANNING_R2_DB_KEY=
# Optional: set fresh paths to verify re-download without removing existing caches.
VOGUE_R2_PLANNING_DB_CACHE_DIR=
VOGUE_R2_IMAGE_CACHE_DIR=
# H&M photos are selected by request category; at most three are analyzed and cached locally.
VOGUE_HM_KAGGLE_IMAGE_ALLOW_PROVIDER_UPLOAD=true
VOGUE_HM_IMAGE_ANALYSIS_ENABLED=true
VOGUE_HM_IMAGE_ANALYSIS_MODEL=gpt-6-astra
VOGUE_HM_IMAGE_REFERENCE_LIMIT=3
# R2 stock photos may be forwarded to the outfit image provider by default.
VOGUE_R2_IMAGE_ALLOW_PROVIDER_UPLOAD=true
